<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_phase2"
    android:fillViewport="true">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="@dimen/tt_screen_horizontal" android:paddingTop="24dp" android:paddingEnd="@dimen/tt_screen_horizontal" android:paddingBottom="30dp">

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/statistics" android:textAppearance="@style/TextAppearance.TruthTest.Hero" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/statistics_subtitle" android:textAppearance="@style/TextAppearance.TruthTest.Body" />

        <TextView android:id="@+id/emptyState" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:background="@drawable/bg_panel_phase2" android:gravity="center" android:padding="20dp" android:text="@string/stats_no_data" android:textColor="@color/p2_text_secondary" android:visibility="gone" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:orientation="horizontal">
            <com.google.android.material.card.MaterialCardView style="@style/Widget.TruthTest.Card" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginEnd="6dp" android:layout_weight="1" app:strokeColor="@color/p2_purple">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
                    <TextView android:id="@+id/averageValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/p2_purple" android:textSize="30sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="@string/stats_average" android:textColor="@color/p2_text_secondary" android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView style="@style/Widget.TruthTest.Card" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:layout_weight="1" app:strokeColor="@color/p2_cyan">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
                    <TextView android:id="@+id/bestScoreValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/p2_cyan" android:textSize="30sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="@string/stats_best_score" android:textColor="@color/p2_text_secondary" android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <GridLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:columnCount="2">
            <com.google.android.material.card.MaterialCardView style="@style/Widget.TruthTest.Card" android:layout_width="0dp" android:layout_height="110dp" android:layout_columnWeight="1" android:layout_margin="5dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp">
                    <TextView android:id="@+id/totalTestsValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/p2_text_primary" android:textSize="25sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/stats_total_tests" android:textColor="@color/p2_text_secondary" android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView style="@style/Widget.TruthTest.Card" android:layout_width="0dp" android:layout_height="110dp" android:layout_columnWeight="1" android:layout_margin="5dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp">
                    <TextView android:id="@+id/testsTodayValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/p2_text_primary" android:textSize="25sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/stats_tests_today" android:textColor="@color/p2_text_secondary" android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView style="@style/Widget.TruthTest.Card" android:layout_width="0dp" android:layout_height="110dp" android:layout_columnWeight="1" android:layout_margin="5dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp">
                    <TextView android:id="@+id/duelValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/p2_pink" android:textSize="25sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/stats_duel_challenges" android:textColor="@color/p2_text_secondary" android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView style="@style/Widget.TruthTest.Card" android:layout_width="0dp" android:layout_height="110dp" android:layout_columnWeight="1" android:layout_margin="5dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp">
                    <TextView android:id="@+id/currentStreakValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/p2_gold" android:textSize="25sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/stats_current_streak" android:textColor="@color/p2_text_secondary" android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </GridLayout>

        <com.google.android.material.card.MaterialCardView style="@style/Widget.TruthTest.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/stats_best_streak" android:textColor="@color/p2_text_secondary" android:textSize="12sp" />
                        <TextView android:id="@+id/bestStreakValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="@color/p2_text_primary" android:textSize="22sp" android:textStyle="bold" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="end" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/stats_favorite_category" android:textColor="@color/p2_text_secondary" android:textSize="12sp" />
                        <TextView android:id="@+id/favoriteCategoryValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="@color/p2_cyan" android:textSize="19sp" android:textStyle="bold" />
                        <TextView android:id="@+id/favoriteCategoryMeta" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textColor="@color/p2_text_muted" android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView style="@style/Widget.TruthTest.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/stats_recent_scores" android:textColor="@color/p2_text_primary" android:textSize="18sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="@string/stats_recent_scores_note" android:textColor="@color/p2_text_secondary" android:textSize="12sp" />
                <com.halashasneen.truthtest.ui.statistics.ScoreTrendView android:id="@+id/trendView" android:layout_width="match_parent" android:layout_height="190dp" android:layout_marginTop="8dp" />
                <TextView android:id="@+id/trendEmpty" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:padding="24dp" android:text="@string/stats_no_data_short" android:textColor="@color/p2_text_secondary" android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/monthlyReportButton"
            style="@style/Widget.TruthTest.SecondaryButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="14dp"
            android:text="@string/monthly_report_export" />
    </LinearLayout>
</ScrollView>