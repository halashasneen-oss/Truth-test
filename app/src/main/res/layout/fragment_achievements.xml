<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_phase2"
    android:fillViewport="true">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="@dimen/tt_screen_horizontal" android:paddingTop="24dp" android:paddingEnd="@dimen/tt_screen_horizontal" android:paddingBottom="28dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/achievements" android:textAppearance="@style/TextAppearance.TruthTest.Hero" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/achievements_subtitle" android:textAppearance="@style/TextAppearance.TruthTest.Body" />

        <com.google.android.material.card.MaterialCardView style="@style/Widget.TruthTest.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
                <TextView android:id="@+id/streakSummary" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/p2_gold" android:textSize="17sp" android:textStyle="bold" />
                <TextView android:id="@+id/progressSummary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:textColor="@color/p2_text_secondary" android:textSize="13sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView android:id="@+id/firstBadge" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:background="@drawable/bg_panel_phase2" android:minHeight="74dp" android:gravity="center_vertical" android:padding="18dp" android:textSize="16sp" />
        <TextView android:id="@+id/tenBadge" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:background="@drawable/bg_panel_phase2" android:minHeight="74dp" android:gravity="center_vertical" android:padding="18dp" android:textSize="16sp" />
        <TextView android:id="@+id/fiftyBadge" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:background="@drawable/bg_panel_phase2" android:minHeight="74dp" android:gravity="center_vertical" android:padding="18dp" android:textSize="16sp" />
        <TextView android:id="@+id/hundredBadge" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:background="@drawable/bg_panel_phase2" android:minHeight="74dp" android:gravity="center_vertical" android:padding="18dp" android:textSize="16sp" />
        <TextView android:id="@+id/highBadge" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:background="@drawable/bg_panel_phase2" android:minHeight="74dp" android:gravity="center_vertical" android:padding="18dp" android:textSize="16sp" />
        <TextView android:id="@+id/streakBadge" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:background="@drawable/bg_panel_phase2" android:minHeight="74dp" android:gravity="center_vertical" android:padding="18dp" android:textSize="16sp" />
        <TextView android:id="@+id/streakSevenBadge" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:background="@drawable/bg_panel_phase2" android:minHeight="74dp" android:gravity="center_vertical" android:padding="18dp" android:textSize="16sp" />
        <TextView android:id="@+id/duelBadge" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:background="@drawable/bg_panel_phase2" android:minHeight="74dp" android:gravity="center_vertical" android:padding="18dp" android:textSize="16sp" />
        <TextView android:id="@+id/groupBadge" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:background="@drawable/bg_panel_phase2" android:minHeight="74dp" android:gravity="center_vertical" android:padding="18dp" android:textSize="16sp" />
        <TextView android:id="@+id/customBadge" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:layout_marginBottom="12dp" android:background="@drawable/bg_panel_phase2" android:minHeight="74dp" android:gravity="center_vertical" android:padding="18dp" android:textSize="16sp" />
    </LinearLayout>
</ScrollView>