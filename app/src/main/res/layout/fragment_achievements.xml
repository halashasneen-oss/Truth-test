<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/app_background" android:orientation="vertical" android:padding="20dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/achievements" android:textColor="@color/app_text_primary" android:textSize="28sp" android:textStyle="bold" />
    <TextView android:id="@+id/firstBadge" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:background="@drawable/bg_surface" android:padding="20dp" android:textSize="20sp" />
    <TextView android:id="@+id/tenBadge" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/bg_surface" android:padding="20dp" android:textSize="20sp" />
    <TextView android:id="@+id/highBadge" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/bg_surface" android:padding="20dp" android:textSize="20sp" />
</LinearLayout>
