<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_phase2"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/tt_screen_horizontal"
        android:paddingTop="24dp"
        android:paddingEnd="@dimen/tt_screen_horizontal"
        android:paddingBottom="32dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/p4_share_studio"
            android:textAppearance="@style/TextAppearance.TruthTest.Hero" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="@string/p4_share_studio_body"
            android:textAppearance="@style/TextAppearance.TruthTest.Body" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/sourceButton"
            style="@style/Widget.TruthTest.SecondaryButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="18dp"
            android:text="@string/p4_choose_source" />

        <TextView
            android:id="@+id/sourceMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/p2_text_secondary"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/templateButton"
                style="@style/Widget.TruthTest.SecondaryButton"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_weight="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/formatButton"
                style="@style/Widget.TruthTest.SecondaryButton"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/ctaButton"
                style="@style/Widget.TruthTest.SecondaryButton"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_weight="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/soundButton"
                style="@style/Widget.TruthTest.SecondaryButton"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.TruthTest.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/showProfileSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="@string/p4_show_profile"
                    android:textColor="@color/p2_text_primary" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/showModeSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:checked="true"
                    android:text="@string/p4_show_mode"
                    android:textColor="@color/p2_text_primary" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/includeQrSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:checked="true"
                    android:text="@string/p4_include_challenge_qr"
                    android:textColor="@color/p2_text_primary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@string/p4_preview"
            android:textAppearance="@style/TextAppearance.TruthTest.Title" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.TruthTest.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:cardBackgroundColor="@color/p2_surface_strong">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="420dp"
                android:padding="10dp">

                <ImageView
                    android:id="@+id/previewImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:adjustViewBounds="true"
                    android:contentDescription="@string/p4_preview"
                    android:scaleType="centerInside" />

                <ProgressBar
                    android:id="@+id/previewProgress"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center" />
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/videoNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/p4_story_video_only"
            android:textColor="@color/p2_text_muted"
            android:textSize="11sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/shareImageButton"
            style="@style/Widget.TruthTest.PrimaryButton"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="18dp"
            android:text="@string/p4_share_image" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/shareVideoButton"
            style="@style/Widget.TruthTest.SecondaryButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:text="@string/p4_share_video" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/createQrButton"
                style="@style/Widget.TruthTest.SecondaryButton"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_weight="1"
                android:text="@string/p4_create_qr" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/scanQrButton"
                style="@style/Widget.TruthTest.SecondaryButton"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/p4_scan_qr" />
        </LinearLayout>

        <TextView
            android:id="@+id/shareHistoryText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_panel_phase2"
            android:padding="16dp"
            android:textColor="@color/p2_text_secondary"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="@string/p4_privacy_note"
            android:textColor="@color/p2_text_muted"
            android:textSize="11sp" />
    </LinearLayout>
</ScrollView>