<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="@color/app_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/welcome" android:textColor="@color/app_text_primary" android:textSize="28sp" android:textStyle="bold" />
        <com.nuvexa.truthtest.ui.custom.WaveformView android:id="@+id/ambientWaveform" android:layout_width="match_parent" android:layout_height="72dp" android:layout_marginTop="8dp" android:alpha="0.45" />
        <com.google.android.material.card.MaterialCardView android:id="@+id/soloCard" android:layout_width="match_parent" android:layout_height="104dp" android:layout_marginTop="16dp" android:clickable="true" android:focusable="true" app:cardBackgroundColor="@color/purple" app:cardCornerRadius="20dp"><TextView android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:padding="24dp" android:text="@string/solo_card_label" android:textColor="@android:color/white" android:textSize="22sp" android:textStyle="bold" /></com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView android:id="@+id/duelCard" android:layout_width="match_parent" android:layout_height="104dp" android:layout_marginTop="12dp" android:clickable="true" android:focusable="true" app:cardBackgroundColor="@color/pink" app:cardCornerRadius="20dp"><TextView android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:padding="24dp" android:text="@string/duel_card_label" android:textColor="@android:color/white" android:textSize="22sp" android:textStyle="bold" /></com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView android:id="@+id/customCard" android:layout_width="match_parent" android:layout_height="104dp" android:layout_marginTop="12dp" android:clickable="true" android:focusable="true" app:cardBackgroundColor="@color/cyan" app:cardCornerRadius="20dp"><TextView android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:padding="24dp" android:text="@string/custom_card_label" android:textColor="#071015" android:textSize="22sp" android:textStyle="bold" /></com.google.android.material.card.MaterialCardView>
        <LinearLayout android:id="@+id/dailyCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:background="@drawable/bg_surface" android:orientation="vertical" android:padding="18dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/daily_challenge" android:textColor="@color/pink" android:textSize="14sp" android:textStyle="bold" />
            <TextView android:id="@+id/dailyQuestion" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="@color/app_text_primary" android:textSize="18sp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/dailyStart" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="@string/start_now" />
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:gravity="center" android:text="@string/privacy_audio" android:textColor="@color/app_text_secondary" android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
