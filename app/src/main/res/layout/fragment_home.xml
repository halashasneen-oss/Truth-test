<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/app_background"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="22dp"
        android:paddingEnd="20dp"
        android:paddingBottom="28dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/welcome"
            android:textColor="@color/app_text_primary"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/home_tagline"
            android:textColor="@color/app_text_secondary"
            android:textSize="15sp" />

        <com.nuvexa.truthtest.ui.custom.WaveformView
            android:id="@+id/ambientWaveform"
            android:layout_width="match_parent"
            android:layout_height="66dp"
            android:layout_marginTop="10dp"
            android:alpha="0.55" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="-4dp"
            android:background="@drawable/bg_surface"
            android:paddingStart="12dp"
            android:paddingTop="7dp"
            android:paddingEnd="12dp"
            android:paddingBottom="7dp"
            android:text="@string/offline_badge"
            android:textColor="@color/app_text_secondary"
            android:textSize="11sp" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/soloCard"
            android:layout_width="match_parent"
            android:layout_height="116dp"
            android:layout_marginTop="20dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            app:cardBackgroundColor="@color/purple"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:strokeColor="#55FFFFFF"
            app:strokeWidth="1dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="vertical" android:paddingStart="22dp" android:paddingEnd="22dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/solo_card_label" android:textColor="@android:color/white" android:textSize="22sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="@string/solo_card_subtitle" android:textColor="#D9FFFFFF" android:textSize="13sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/duelCard"
            android:layout_width="match_parent"
            android:layout_height="116dp"
            android:layout_marginTop="12dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            app:cardBackgroundColor="@color/pink"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:strokeColor="#55FFFFFF"
            app:strokeWidth="1dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="vertical" android:paddingStart="22dp" android:paddingEnd="22dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/duel_card_label" android:textColor="@android:color/white" android:textSize="22sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="@string/duel_card_subtitle" android:textColor="#D9FFFFFF" android:textSize="13sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/groupCard"
            android:layout_width="match_parent"
            android:layout_height="116dp"
            android:layout_marginTop="12dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            app:cardBackgroundColor="@color/orange"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:strokeColor="#55FFFFFF"
            app:strokeWidth="1dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="vertical" android:paddingStart="22dp" android:paddingEnd="22dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/group_card_label" android:textColor="@android:color/white" android:textSize="22sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="@string/group_card_subtitle" android:textColor="#E6FFFFFF" android:textSize="13sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/customCard"
            android:layout_width="match_parent"
            android:layout_height="116dp"
            android:layout_marginTop="12dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            app:cardBackgroundColor="@color/cyan"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:strokeColor="#55071015"
            app:strokeWidth="1dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="vertical" android:paddingStart="22dp" android:paddingEnd="22dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/custom_card_label" android:textColor="#071015" android:textSize="22sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="@string/custom_card_subtitle" android:textColor="#B8071015" android:textSize="13sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/dailyCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardBackgroundColor="@color/app_surface"
            app:cardCornerRadius="22dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/pink"
            app:strokeWidth="1dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/daily_challenge" android:textColor="@color/pink" android:textSize="13sp" android:textStyle="bold" />
                <TextView android:id="@+id/dailyQuestion" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="@color/app_text_primary" android:textSize="19sp" android:textStyle="bold" />
                <com.google.android.material.button.MaterialButton android:id="@+id/dailyStart" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/start_now" app:cornerRadius="18dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="@string/privacy_audio"
            android:textColor="@color/app_text_secondary"
            android:textSize="11sp" />
    </LinearLayout>
</ScrollView>
